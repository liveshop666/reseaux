# ---------------------------------------------------------------
# Copie ce fichier en .env.local (en local) ou mets ces variables
# dans Vercel > Project > Settings > Environment Variables
# ---------------------------------------------------------------

# Supabase : LE MÊME projet que le CRM (crm-prospection) → mêmes 3 valeurs que dans le Vercel du CRM
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# ⚠️ SECRÈTE : ne jamais la partager ni la mettre côté navigateur
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Adresse publique du Studio (sert pour la connexion TikTok)
NEXT_PUBLIC_APP_URL=https://studio-reseaux.vercel.app

# Emails autorisés à ouvrir le Studio (séparés par des virgules) — même valeur que le CRM
ALLOWED_EMAILS=toi@tondomaine.fr

# Clé que n8n envoie dans le header x-api-key (et que le Studio envoie à n8n).
# Astuce : mets la MÊME valeur que CRM_API_KEY pour réutiliser l'identifiant n8n « CRM x-api-key ».
STUDIO_API_KEY=change-moi

# n8n : adresses « Production URL » des nœuds Webhook (voir n8n/README.md)
# - workflow « Studio 1 – Adapter le texte (Gemini) »
N8N_ADAPT_WEBHOOK_URL=
# - workflow « Studio 2 – Publier »
N8N_PUBLISH_WEBHOOK_URL=

# TikTok (developers.tiktok.com > ton app > Client key / Client secret) — facultatif
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
