    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Remet la vidéo (le nœud précédent ne la transmet pas) et vérifie la réponse de TikTok.\nconst prep = $('TikTok : préparer').item;\nif (prep.json._stop) return { json: { _stop: true, erreur: prep.json.erreur } };\nconst d = $json.data ?? {};\nif (!d.upload_url) return { json: { _stop: true, erreur: 'TikTok : ' + ($json.error?.message || $json.error?.code || 'déclaration refusée') } };\nreturn { json: { upload_url: d.upload_url, publish_id: d.publish_id, size: prep.json.size, access_token: prep.json.access_token, privacy: prep.json.privacy }, binary: prep.binary };"
      },
